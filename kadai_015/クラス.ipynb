        "class Human:\n",
        "  def __init__(self, name, age):\n",
        "    self.name=name\n",
        "    self.age=age\n",
        "\n",
        "  def printinfo(self):\n",
        "    print(self.name, self.age)\n",
        "\n",
        "human = Human(\"taro\", 20)\n",
        "human2 = Human(\"jiro\", 10)\n",
        "human.printinfo()\n",
        "human2.printinfo()\n",
        "\n",
        "\n"
      ]
    }
  ]
